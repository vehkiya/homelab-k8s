{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "kustomize": {
    "enabled": true
  },
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Chisinau",
  "rebaseWhen": "behind-base-branch",
  "labels": [
    "renovate",
    "dependencies"
  ],
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "prHeader": "## 🤖 Renovate: Dependency Maintenance",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z\\-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+-\\s+https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/(?:refs/tags/)?(?<currentValue>[^/]+)/"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Automerge Docker digest and pinDigest updates once CI passes",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge patch updates for user workloads once CI passes",
      "matchFileNames": [
        "apps/workloads/**"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "groupName": "argocd",
      "matchPackageNames": [
        "quay.io/argoproj/argocd",
        "argoproj/argo-cd"
      ]
    },
    {
      "groupName": "multus",
      "matchPackageNames": [
        "k8snetworkplumbingwg/multus-cni",
        "ghcr.io/siderolabs/install-cni"
      ]
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "pinDigests": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "matchManagers": [
        "kustomize"
      ],
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "groupName": "bar-assistant",
      "matchFileNames": [
        "apps/workloads/home/bar-assistant/**"
      ]
    },
    {
      "groupName": "traefik-group",
      "matchPackageNames": [
        "/traefik/"
      ]
    },
    {
      "groupName": "synology-csi-drivers",
      "matchFileNames": [
        "apps/system/storage/synology-csi/**"
      ]
    },
    {
      "groupName": "iot-stack",
      "matchPackageNames": [
        "ghcr.io/koenkk/zigbee2mqtt",
        "eclipse-mosquitto",
        "ghcr.io/matter-js/matterjs-server",
        "ghcr.io/home-operations/home-assistant"
      ]
    },
    {
      "groupName": "db-stack",
      "matchPackageNames": [
        "redis",
        "getmeili/meilisearch"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "plexinc/pms-docker"
      ],
      "versioning": "loose",
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+-[0-9a-f]+$/"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "matchPackageNames": [
        "renovate/renovate",
        "kube-prometheus-stack"
      ],
      "description": "Daily maintenance window for core GitOps and monitoring components",
      "schedule": [
        "before 4am"
      ]
    },
    {
      "matchManagers": [
        "kustomize"
      ],
      "matchPackageNames": [
        "ghcr.io/spegel-org/helm-charts/spegel",
        "ghcr.io/n8n-io/n8n-helm-chart/n8n",
        "ghcr.io/intel/intel-resource-drivers-for-kubernetes/intel-gpu-resource-driver-chart",
        "spegel",
        "n8n",
        "intel-gpu-resource-driver-chart"
      ],
      "pinDigests": false,
      "description": "Disable pinning for OCI charts as Kustomize helmCharts doesn't support digests"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "groupName": "github-actions",
      "schedule": [
        "every weekend"
      ],
      "automerge": false,
      "description": "Group all GitHub Actions updates and schedule them weekly (manual review)"
    },
    {
      "matchPackageNames": ["ghcr.io/matter-js/matterjs-server"],
      "changelogUrl": "https://github.com/matter-js/matterjs-server/blob/main/CHANGELOG.md"
    },
    {
      "groupName": "fluxerapp",
      "matchPackageNames": [
        "/^ghcr\\.io/fluxerapp//"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge Renovate bot maintenance updates once CI passes",
      "matchPackageNames": [
        "renovate/renovate",
        "ghcr.io/mend/renovate-ce"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "groupName": "dragonfly",
      "matchPackageNames": [
        "ghcr.io/dragonflydb/dragonfly",
        "dragonflydb/dragonfly",
        "/dragonfly/"
      ]
    },
    {
      "groupName": "valkey",
      "matchPackageNames": [
        "docker.io/valkey/valkey",
        "valkey/valkey",
        "valkey",
        "/valkey/"
      ]
    },
    {
      "description": "Require manual review for core infrastructure non-digest updates",
      "matchFileNames": [
        "apps/bootstrap/**",
        "apps/system/**",
        "apps/data-services/**"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "automerge": false
    },
    {
      "description": "Automerge Prometheus (kube-prometheus-stack) incremental updates once CI passes",
      "matchPackageNames": [
        "kube-prometheus-stack",
        "/prometheus/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Require manual review for all major version bumps",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
