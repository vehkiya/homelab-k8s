    {
      "type": "timeseries",
      "title": "Ignored frames per minute",
      "description": "Frames read from net1 that weren't Matter traffic for the mesh. The BPF filter keeps this near zero; a rise means the filter isn't attached.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(thread_udp_proxy_ignored_frames_total[$__rate_interval])) * 60",
