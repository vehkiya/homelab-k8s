        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Active clients",
      "description": "Matter controllers (address and port) with an open relay socket.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(thread_udp_proxy_active_clients)",
          "legendFormat": "Clients",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
