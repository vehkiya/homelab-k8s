          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(thread_udp_proxy_reply_latency_seconds_bucket[30m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(thread_udp_proxy_reply_latency_seconds_bucket[30m])))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
