      }
    },
    {
      "type": "timeseries",
      "title": "Reply latency",
      "description": "Kernel receive from the mesh to the frame written back on net1. Percentiles over a 30 minute window, since traffic is sparse; values are histogram bucket bounds.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
