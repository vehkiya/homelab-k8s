            "renameByName": {
              "device": "Device",
              "Value #A": "Availability",
              "Value #B": "Link quality",
              "Value #C": "Battery",
              "Value #D": "Messages (24h)"
            },
            "indexByName": {
              "device": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            }
